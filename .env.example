# ==================== SUPER ADMIN ====================
# ⚠️  Production'ga chiqishdan oldin ALBATTA o'zgartiring
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
# openssl rand -base64 32  bilan yarating:
APP_CREDENTIALS_MASTER_KEY=CHANGE_THIS_LONG_RANDOM_SECRET
# APP_CREDENTIALS_OLD_MASTER_KEYS=old_secret_one,old_secret_two

# ==================== JIRA (Global / Fallback) ====================
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token

# ==================== GITHUB ====================
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_ORG=your-org-name

# ==================== GEMINI AI ====================
GOOGLE_API_KEY=AIzaSy_your_key_here
# GOOGLE_API_KEY_2=AIzaSy_backup_key  (ixtiyoriy)
GEMINI_MODEL=gemini-2.5-pro
# Asosiy model barcha retry'dan o'tib ham 503 bersa shu modelga o'tadi:
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ==================== DATABASE ====================
# Local ishlatish:
APP_POSTGRES_DSN=postgresql://localhost/jira_ai_analyzer
# Testlar uchun alohida DB (yo'q bo'lsa DB testlari skip bo'ladi):
# APP_TEST_POSTGRES_DSN=postgresql://localhost/jira_ai_test
# Docker Compose da backend/worker uchun avtomatik o'rnatiladi:
# APP_POSTGRES_DSN=postgresql://jira_ai_analyzer:PASSWORD@postgres:5432/jira_ai_analyzer
POSTGRES_DB=jira_ai_analyzer
POSTGRES_USER=jira_ai_analyzer
# ⚠️  Production'da kuchli parol ishlating:
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# --- DB connection pool (har jarayon uchun) ---
# Pool o'lchami ENV orqali beriladi (DB'dan emas — pool DB'dan oldin quriladi).
# MUHIM: (jarayonlar soni) × APP_DB_POOL_MAX_SIZE ≤ postgres max_connections (default 100) − zaxira.
# Masalan backend + worker = 2 jarayon → 2 × 10 = 20 ulanish (xavfsiz).
# APP_DB_POOL_MIN_SIZE=1            # startup'da ochiladigan minimal ulanish
# APP_DB_POOL_MAX_SIZE=10          # bir jarayon eng ko'p shuncha ulanish ochadi
# APP_DB_POOL_TIMEOUT=30           # bo'sh ulanish kutish (sekund), oshsa xato
# APP_DB_CONNECT_TIMEOUT=30        # bitta ulanish ochish timeouti (sekund)

# ==================== APP RUNTIME ====================
APP_USE_BACKEND_API=true
APP_BACKEND_API_BASE_URL=http://127.0.0.1:8000
# Backend/frontend qaysi tarmoq interfeysiga bog'lanadi (start.bat o'qiydi).
# Default 127.0.0.1 — faqat shu kompyuterdan kirish mumkin (xavfsiz).
# LAN kirish kerak bo'lsa (FAQAT firewall ortida): 0.0.0.0 qiling.
# Internet kirish uchun 8000/3000 ni HECH QACHON to'g'ridan-to'g'ri ochmang —
# TLS reverse proxy MAJBURIY (DEPLOY_WINDOWS.md, 7-bo'lim).
# APP_BIND_HOST=127.0.0.1
# JIRA webhook body hajm cheklovi (bayt). Default 2 MB.
# APP_WEBHOOK_MAX_BODY_BYTES=2097152
# Webhook ishlov rejimi:
#   queue  — job'lar alohida worker jarayonida bajariladi (PRODUCTION uchun MAJBURIY).
#            Reaper, stuck-'progressing' sweeper va retention faqat worker ichida
#            ishlaydi — worker jarayoni shart (start.bat / worker uni ishga tushiradi).
#   inline — faqat yengil bitta-jarayonli dev uchun (crash-recovery YO'Q).
APP_WEBHOOK_EXECUTION_MODE=queue
# Production webhook'larida company webhook_secret majburiy bo'lsin.
# true bo'lsa: secret'i sozlanmagan kompaniya webhook'i 401 oladi. Yangi
# kompaniya yaratilganda webhook_secret avtomatik generatsiya qilinadi —
# uni admin paneldan olib JIRA webhook'iga X-Webhook-Secret header sifatida qo'ying.
APP_WEBHOOK_REQUIRE_SECRET=true
# Task avtomatik qaytarilishi mumkin bo'lgan maksimal son (cheksiz return
# loop'ining oldini oladi — har qaytarish to'liq AI xarajati). 0 = cheksiz.
# APP_MAX_RETURN_COUNT=3
APP_WORKER_POLL_INTERVAL_SECONDS=3
APP_WORKER_NAME=worker-1

# --- Multi-worker (≥2 worker) ---
# Bir kompaniyaga bir vaqtda faqat 1 ta AI job (DB claim serializatsiyasi orqali).
# Ilgari bu 'kompaniyaga 1 AI task' kafolati worker-ichi dict'da edi — N worker
# bilan yo'qolardi. Bitta worker uchun ta'sirsiz. false = klassik (cheklovsiz) claim.
# APP_QUEUE_PER_COMPANY_CONCURRENCY=true

# --- Crash-recovery (worker reaper/sweeper) ---
# Stale 'running' job qayta navbatga (crash bo'lgan worker): normal run ~3-8 daq.
# APP_STALE_JOB_TIMEOUT_SECONDS=1800    # 30 daq — bundan uzun 'running' = o'lik
# APP_STUCK_TASK_TIMEOUT_MINUTES=60     # 60 daq qotgan 'progressing' task -> error
# APP_REAPER_INTERVAL_SECONDS=120       # reaper/sweeper qanchalik tez tekshiradi

# --- Watchdog (ogohlantirish: navbat/blocked/worker) ---
# API jarayonida davriy ishlaydi; muammo bo'lsa WARNING log + (email sozlansa) email.
# APP_WATCHDOG_ENABLED=true
# APP_WATCHDOG_ALERT_EMAIL=ops@company.com   # bo'sh bo'lsa faqat log (SMTP yuqorida)
# APP_WATCHDOG_INTERVAL_SECONDS=300          # tekshirish davriyligi
# APP_WATCHDOG_QUEUE_THRESHOLD=20            # queued >= shu bo'lsa alert
# APP_WATCHDOG_WORKER_STALE_SECONDS=900      # heartbeat shundan eski -> worker o'lgan
# APP_WATCHDOG_COOLDOWN_SECONDS=3600         # bir xil alertni qayta yubormaslik oynasi
# APP_WORKER_HEARTBEAT_SECONDS=60            # worker heartbeat yozish davriyligi

# --- DB retention (eski yozuvlarni davriy o'chirish) ---
# Cheksiz jadval o'sishining oldini oladi. Worker default kuniga bir ishlatadi.
# APP_RETENTION_ENABLED=true            # false = tozalash o'chiriladi
# APP_RETENTION_INTERVAL_SECONDS=86400  # tozalash davriyligi (default kuniga bir)
# APP_RETENTION_RUN_DAYS=90             # checker_runs/analysis_runs saqlash muddati
# APP_RETENTION_JOB_DAYS=30             # tugagan (done/failed) job_queue yozuvlari
# APP_RETENTION_USAGE_DAYS=365          # ai_usage_events (xarajat leggeri — uzunroq)
# Session TTL (daqiqa) — web sessiya APP_WEB_SESSION_TTL_MINUTES bo'lmasa shunga tushadi:
APP_SESSION_TIMEOUT_MINUTES=120
# APP_WEB_SESSION_TTL_MINUTES=120
# Sprint report API endpoint uchun token (ixtiyoriy):
# SPRINT_REPORT_API_TOKEN=your_internal_token

# ==================== EMAIL (Parol tiklash uchun) ====================
# Gmail: smtp.gmail.com:587  |  Yandex: smtp.yandex.ru:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=siz@gmail.com
SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=siz@gmail.com   (default: SMTP_USER)
# SMTP_FROM_NAME=QA Assistant     (default)
# Reset link uchun (production domeningiz):
APP_BASE_URL=http://localhost:3000
# Parol tiklash token amal qilish muddati (daqiqa, min 5):
APP_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ==================== TELEGRAM LEAD BILDIRISHNOMA ====================
# Landing/demo formasidan yangi lid kelganda Telegram'ga xabar yuboriladi.
# 1) @BotFather -> /newbot -> token oling
# 2) Botingizga /start bosing, so'ng @userinfobot sizga raqamli chat id beradi
# Bo'sh qoldirilsa: lid baribir DB'ga yoziladi (super-admin "Lidlar" tab), xabar bo'lmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== SECURITY ====================
# Production'da true qiling — master key yo'qligida server ishga tushmasin
# (credential shifrlash fail-closed bo'ladi + webhook secret majburiy).
APP_STRICT_MODE=true
# Ruxsat etilgan frontend origin(lar), vergul bilan ajratilgan
ALLOWED_ORIGINS=http://localhost:3000
# Kompaniya webhook secret'i — DB'da company settings da saqlaning (webhook_secret maydoni)
# Har kompaniya uchun admin paneldan sozlanadi, bu yerda emas

# ==================== PATHS ====================
# Ixtiyoriy — standart holda ./data ishlatiladi
# DATA_DIR=/opt/jira-ai/data
# EXCEL_DIR=/opt/jira-ai/data/excel_reports
# MODELS_DIR=/opt/jira-ai/models
# CACHE_DIR=/opt/jira-ai/data/cache

# ==================== FRONTEND (Next.js — frontend/.env.local) ====================
# Frontend backend API'ga qaysi manzildan ulanadi (serverda absolyut URL bering):
# BACKEND_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_BACKEND_API_BASE_URL=http://127.0.0.1:8000
