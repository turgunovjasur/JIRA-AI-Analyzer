# ==================== SUPER ADMIN ====================
# ⚠️  Production'ga chiqishdan oldin ALBATTA o'zgartiring
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
# openssl rand -base64 32  bilan yarating:
APP_CREDENTIALS_MASTER_KEY=CHANGE_THIS_LONG_RANDOM_SECRET
# APP_CREDENTIALS_OLD_MASTER_KEYS=old_secret_one,old_secret_two

# ==================== JIRA (Global / Fallback) ====================
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token

# ==================== GITHUB ====================
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_ORG=your-org-name

# ==================== GEMINI AI ====================
GOOGLE_API_KEY=AIzaSy_your_key_here
# GOOGLE_API_KEY_2=AIzaSy_backup_key  (ixtiyoriy)
GEMINI_MODEL=gemini-2.5-flash

# ==================== DATABASE ====================
# Local ishlatish:
APP_POSTGRES_DSN=postgresql://localhost/jira_ai_analyzer
# Docker Compose da backend/worker uchun avtomatik o'rnatiladi:
# APP_POSTGRES_DSN=postgresql://jira_ai_analyzer:PASSWORD@postgres:5432/jira_ai_analyzer
POSTGRES_DB=jira_ai_analyzer
POSTGRES_USER=jira_ai_analyzer
# ⚠️  Production'da kuchli parol ishlating:
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# ==================== APP RUNTIME ====================
APP_USE_BACKEND_API=true
APP_BACKEND_API_BASE_URL=http://127.0.0.1:8000
APP_WEBHOOK_EXECUTION_MODE=inline
APP_WORKER_POLL_INTERVAL_SECONDS=3
APP_WORKER_NAME=worker-1

# ==================== SECURITY ====================
# Production'da true qiling — master key yo'qligida server ishga tushmasin
APP_STRICT_MODE=false
# Ruxsat etilgan frontend origin(lar), vergul bilan ajratilgan
ALLOWED_ORIGINS=http://localhost:3000
# Kompaniya webhook secret'i — DB'da company settings da saqlaning (webhook_secret maydoni)
# Har kompaniya uchun admin paneldan sozlanadi, bu yerda emas

# ==================== PATHS ====================
# Ixtiyoriy — standart holda ./data ishlatiladi
# DATA_DIR=/opt/jira-ai/data
# EXCEL_DIR=/opt/jira-ai/data/excel_reports
# VECTOR_DB_PATH=/opt/jira-ai/data/vector_db
# MODELS_DIR=/opt/jira-ai/models

# ==================== EMBEDDING ====================
EMBEDDING_MODEL=intfloat/multilingual-e5-large
MIN_SIMILARITY=0.70
TOP_K_RESULTS=20
